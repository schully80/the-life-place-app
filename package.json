{
  "name": "the-life-place-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && cp public/_redirects dist/_redirects",
    "prebuild": "expo prebuild",
    "clean": "rm -rf node_modules && rm -f package-lock.json && npm install",
    "eas:login": "eas login",
    "eas:init": "eas init",
    "eas:configure": "eas build:configure",
    "eas:build:ios": "eas build -p ios --profile production",
    "eas:build:android": "eas build -p android --profile production",
    "eas:build:dev:ios": "eas build -p ios --profile development",
    "eas:build:dev:android": "eas build -p android --profile development",
    "eas:submit:ios": "eas submit -p ios --latest",
    "eas:submit:android": "eas submit -p android --latest",
    "dev-client:ios": "expo run:ios",
    "dev-client:android": "expo run:android",
    "eas:dev-client:ios": "eas build -p ios --profile development",
    "eas:dev-client:android": "eas build -p android --profile development"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.74.0",
    "expo": "^54.0.31",
    "expo-blur": "~15.0.7",
    "expo-clipboard": "^55.0.9",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.17",
    "expo-font": "~14.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "6.0.14",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.20",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@google/gemini-cli": "^0.1.18",
    "@types/react": "~19.1.10",
    "eas-cli": "^0.0.0",
    "typescript": "~5.9.2"
  }
}
